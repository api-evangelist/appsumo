{
  "opencollection": "1.0.0",
  "info": {
    "name": "AppSumo Licensing Licenses Profile API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-AppSumo-API-Key",
      "value": "{{X-AppSumo-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AppSumo - Get Partner Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://appsumo.com/api/v2/profile"
          },
          "docs": "Returns the partner profile information for the authenticated API key"
        }
      ]
    }
  ],
  "bundled": true
}